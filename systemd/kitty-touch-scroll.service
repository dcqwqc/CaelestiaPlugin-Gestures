[Unit]
Description=Kitty one-finger touchscreen scrolling
After=graphical-session.target ydotool.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/kitty-touch-scroll
Restart=always
RestartSec=1
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket

[Install]
WantedBy=graphical-session.target
