[Unit]
Description=Mirai multi-touch gesture bridge
After=graphical-session.target ydotool.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mirai-gestures daemon
Restart=always
RestartSec=1
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket

[Install]
WantedBy=graphical-session.target
